# Boîte mail connectée du Pôle OETH/AGEFIPH (IMAP/SMTP générique).
# Copiez ce fichier en `.env` (jamais commité, voir .gitignore) et
# renseignez les vraies valeurs. Fonctionnalité entièrement désactivée
# tant que ces variables ne sont pas renseignées — le reste du CRM
# fonctionne normalement sans elles.

# Adresse et mot de passe de la boîte du pôle (utilisez un mot de passe
# d'application si votre fournisseur le propose, plutôt que le mot de passe
# principal du compte).
MAIL_USER=contact@exemple.fr
MAIL_PASSWORD=

# Serveur de réception (IMAP) — généralement port 993 en SSL/TLS.
MAIL_IMAP_HOST=imap.exemple.fr
MAIL_IMAP_PORT=993

# Serveur d'envoi (SMTP) — généralement port 587 (STARTTLS) ou 465 (SSL).
MAIL_SMTP_HOST=smtp.exemple.fr
MAIL_SMTP_PORT=587

# Signature ajoutée par défaut (optionnel).
MAIL_SIGNATURE=Pôle OETH / AGEFIPH

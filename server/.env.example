# Boîte mail connectée du Pôle OETH/AGEFIPH.
# Copiez ce fichier en `.env` (jamais commité, voir .gitignore) et
# renseignez les vraies valeurs.
#
# IMPORTANT — Render (comme la plupart des hébergeurs PaaS) bloque le trafic
# SMTP sortant (ports 25/465/587) au niveau réseau, MÊME SUR UN PLAN PAYANT :
# ce n'est pas une limite du tier gratuit, passer sur un plan payant Render
# ne débloquera pas ces ports. Pour envoyer depuis Render, utilisez donc
# BREVO_API_KEY (envoi via l'API HTTPS de Brevo, jamais bloquée) — le SMTP
# direct (MAIL_SMTP_HOST...) ne fonctionne de façon fiable qu'en local.
#
# Envoi (Brevo ou SMTP) et réception (IMAP) sont INDÉPENDANTS : l'envoi (lien
# magique, mails agents) fonctionne dès que BREVO_API_KEY (+ MAIL_FROM/MAIL_USER
# pour l'adresse d'expédition), OU MAIL_SMTP_HOST/MAIL_HOST + MAIL_USER +
# MAIL_PASSWORD, sont renseignés — même sans IMAP. La relève automatique du
# courrier entrant nécessite en plus MAIL_IMAP_HOST (via la boîte OVH).
#
# Exemple ci-dessous avec les paramètres OVH Mail Pro (contact@oeth-fiph.fr,
# hébergé sur pro1.mail.ovh.net) — adaptez si votre boîte est ailleurs.

# --- Envoi via l'API Brevo (recommandé en production / sur Render) ---
# Créez un compte sur https://www.brevo.com (offre gratuite : 300 mails/jour
# suffisants ici), générez une clé API dans Paramètres > Clés API SMTP & API,
# puis validez contact@oeth-fiph.fr comme expéditeur (Paramètres >
# Expéditeurs, ou validez le domaine oeth-fiph.fr entier pour une meilleure
# délivrabilité via les enregistrements DNS SPF/DKIM que Brevo fournit).
BREVO_API_KEY=

# Adresse et mot de passe de la boîte du pôle (le mot de passe du compte
# mail OVH lui-même ; OVH Mail Pro ne propose pas de mot de passe
# d'application séparé comme Gmail/Microsoft). MAIL_USER/MAIL_PASSWORD
# restent nécessaires pour l'IMAP (réception) même si l'envoi passe par
# Brevo.
MAIL_USER=contact@oeth-fiph.fr
MAIL_PASSWORD=

# --- Envoi via SMTP direct (repli local uniquement, voir avertissement plus haut) ---
# OVH Mail Pro : port 465 (SSL implicite, recommandé) ou 587 (STARTTLS). Le
# code détecte automatiquement le mode SSL si le port est 465.
# Alias acceptés : MAIL_HOST / MAIL_PORT (si vous préférez ces noms).
MAIL_SMTP_HOST=pro1.mail.ovh.net
MAIL_SMTP_PORT=587

# Réception (IMAP, optionnel — nécessaire seulement pour le fil de
# messagerie automatique dans les fiches entreprise). OVH Mail Pro : port
# 993 en SSL/TLS. Aucun alias : IMAP et SMTP n'utilisent pas forcément le
# même host/port, à renseigner explicitement.
MAIL_IMAP_HOST=pro1.mail.ovh.net
MAIL_IMAP_PORT=993

# Adresse d'expédition affichée si différente de MAIL_USER (optionnel —
# par défaut, MAIL_USER est utilisé).
MAIL_FROM=

# Signature ajoutée par défaut (optionnel — un bloc plus complet est déjà
# géré dynamiquement par le frontend selon privé/public).
MAIL_SIGNATURE=Pôle OETH / AGEFIPH

# Coordonnées officielles du pôle affichées dans la signature des mails ET
# sur le PDF de synthèse OETH joint automatiquement aux envois (voir
# server/src/pdfSynthese.js) — renforcent la crédibilité des messages envoyés
# aux entreprises. Optionnel : des valeurs par défaut (coordonnées réelles du
# pôle) sont déjà utilisées dans le code si ces variables sont absentes ;
# ne les renseignez ici que si elles changent.
POLE_ADRESSE=47 rue Eugène Oudiné, 75013 Paris
POLE_TELEPHONE=+33 7 44 12 79 17

# Délai (ms) avant d'abandonner une tentative de connexion/envoi SMTP qui ne
# répond pas (optionnel, défaut 8000). Volontairement court : un délai par
# défaut nodemailer peut atteindre plusieurs minutes, ce qui donne
# l'impression d'une requête bloquée sans jamais afficher d'erreur. Si les
# logs Render affichent un TIMEOUT_MANUEL/ETIMEDOUT à répétition, c'est le
# signe que le port SMTP (587/465) est bloqué en sortie par l'hébergeur, pas
# un problème d'identifiants.
MAIL_TIMEOUT_MS=8000

# ---- Authentification (lien magique + Google) ----

# Secret de signature des sessions et des liens de connexion — générez une
# valeur longue et aléatoire (ex: `openssl rand -hex 32`) et gardez-la
# strictement privée. Sans cette variable, une valeur de développement non
# sécurisée est utilisée : à définir obligatoirement en production.
SESSION_SECRET=

# URL publique du CRM tel qu'un navigateur y accède (utilisée pour construire
# les liens de connexion envoyés par mail). En local avec Vite, laissez la
# valeur par défaut ci-dessous ; sur Render, mettez l'URL du service
# (ex: https://crm-esat-tremplin.onrender.com).
APP_URL=http://localhost:5173

# Connexion Google (optionnelle) : Client ID OAuth 2.0 créé dans Google Cloud
# Console (type "Application Web", pas besoin de Client Secret pour ce flux
# de vérification de jeton côté client). Le bouton "Se connecter avec
# Google" reste masqué tant que cette variable n'est pas renseignée.
GOOGLE_CLIENT_ID=

# Adresses toujours administrateur, séparées par des virgules — utile pour ne
# pas dépendre de l'ordre de création des comptes ("premier compte = admin").
# Une adresse listée ici redevient admin+validée à sa prochaine demande de
# lien, même si elle était restée bloquée en "en_attente" avant.
ADMIN_EMAILS=contact@oeth-fiph.fr,philippepetchams3@gmail.com

# ---- Recherche IA de contact alternatif (optionnel) ----

# Clé API Google Gemini (générée gratuitement sur https://aistudio.google.com/apikey)
# — utilisée par le bouton "Rechercher via IA" de l'espace "Contact alternatif"
# d'une fiche entreprise (numéro signalé invalide) : le modèle utilise la
# recherche Google (grounding) pour proposer un numéro/contact à jour ET une
# catégorie de secteur, à valider manuellement avant application (jamais
# appliqué automatiquement). Alias accepté : GOOGLE_API_KEY. Sans cette clé,
# seules les pistes de recherche manuelles (Google, PagesJaunes...) restent
# proposées.
GEMINI_API_KEY=

# Modèle Gemini à utiliser (optionnel, défaut : un modèle "Flash" récent au
# moment de l'écriture). La nomenclature des modèles Gemini change avec le
# temps — si l'appel échoue avec une erreur de modèle inconnu/indisponible,
# vérifiez le nom exact disponible pour votre clé sur Google AI Studio et
# renseignez-le ici.
GEMINI_MODEL=gemini-2.5-flash

# Boîte mail connectée du Pôle OETH/AGEFIPH (IMAP/SMTP générique).
# Copiez ce fichier en `.env` (jamais commité, voir .gitignore) et
# renseignez les vraies valeurs. Fonctionnalité entièrement désactivée
# tant que ces variables ne sont pas renseignées — le reste du CRM
# fonctionne normalement sans elles.
#
# Exemple ci-dessous avec les paramètres OVH Mail Pro (contact@oeth-fiph.fr,
# hébergé sur pro1.mail.ovh.net) — adaptez si votre boîte est ailleurs.

# Adresse et mot de passe de la boîte du pôle (le mot de passe du compte
# mail OVH lui-même ; OVH Mail Pro ne propose pas de mot de passe
# d'application séparé comme Gmail/Microsoft).
MAIL_USER=contact@oeth-fiph.fr
MAIL_PASSWORD=

# Réception (IMAP) — OVH Mail Pro : port 993 en SSL/TLS.
MAIL_IMAP_HOST=pro1.mail.ovh.net
MAIL_IMAP_PORT=993

# Envoi (SMTP) — OVH Mail Pro : port 465 (SSL implicite, recommandé) ou 587
# (STARTTLS). Le code détecte automatiquement le mode SSL si le port est 465.
MAIL_SMTP_HOST=pro1.mail.ovh.net
MAIL_SMTP_PORT=465

# Signature ajoutée par défaut (optionnel — un bloc plus complet est déjà
# géré dynamiquement par le frontend selon privé/public).
MAIL_SIGNATURE=Pôle OETH / AGEFIPH

# ---- Authentification (lien magique + Google) ----

# Secret de signature des sessions et des liens de connexion — générez une
# valeur longue et aléatoire (ex: `openssl rand -hex 32`) et gardez-la
# strictement privée. Sans cette variable, une valeur de développement non
# sécurisée est utilisée : à définir obligatoirement en production.
SESSION_SECRET=

# URL publique du CRM tel qu'un navigateur y accède (utilisée pour construire
# les liens de connexion envoyés par mail). En local avec Vite, laissez la
# valeur par défaut ci-dessous ; sur Render, mettez l'URL du service
# (ex: https://crm-esat-tremplin.onrender.com).
APP_URL=http://localhost:5173

# Connexion Google (optionnelle) : Client ID OAuth 2.0 créé dans Google Cloud
# Console (type "Application Web", pas besoin de Client Secret pour ce flux
# de vérification de jeton côté client). Le bouton "Se connecter avec
# Google" reste masqué tant que cette variable n'est pas renseignée.
GOOGLE_CLIENT_ID=

# Adresses toujours administrateur, séparées par des virgules — utile pour ne
# pas dépendre de l'ordre de création des comptes ("premier compte = admin").
# Une adresse listée ici redevient admin+validée à sa prochaine demande de
# lien, même si elle était restée bloquée en "en_attente" avant.
ADMIN_EMAILS=contact@oeth-fiph.fr,philippepetchams3@gmail.com
